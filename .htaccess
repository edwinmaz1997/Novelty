Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^auto/([0-9]+)(-[a-z0-9-]*)?/?$ auto.php?id=$1 [L,QSA]
</IfModule>

<FilesMatch "\.(sql|md|log|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
