Options -Indexes -MultiViews
DirectoryIndex index.php
ErrorDocument 404 /404.php

AddType image/x-icon .ico
AddType application/manifest+json .webmanifest

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) URLs viejas con .php → versión limpia (solo GET, para no romper formularios)
  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+auto\.php\?id=([0-9]+)[\s&] [NC]
  RewriteRule ^ /auto/%1? [R=301,L]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+((?:[^\s?]*/)?)index\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  RewriteCond %{REQUEST_METHOD} =GET
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.php[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L,NE]

  # Íconos: si en Ajustes se subió uno propio, se sirve el personalizado en la misma dirección
  RewriteCond %{DOCUMENT_ROOT}/uploads/sitio/iconos/$1 -f
  RewriteRule ^(favicon\.ico|favicon-32\.png|apple-touch-icon\.png|apple-touch-icon-precomposed\.png|icon-192\.png|icon-512\.png)$ uploads/sitio/iconos/$1 [L]
  RewriteRule ^apple-touch-icon-precomposed\.png$ apple-touch-icon.png [L]
  RewriteRule ^manifest\.webmanifest$ manifest.php [L]

  # SEO: robots, mapa del sitio y páginas de marca
  RewriteRule ^robots\.txt$ robots.php [L]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]
  RewriteRule ^autos/marca/([a-z0-9-]+)/?$ autos.php?marca_slug=$1 [L,QSA]

  # 2) Ficha de vehículo: /auto/12-toyota-hilux-2021
  RewriteRule ^auto/([0-9]+)(-[a-z0-9-]*)?/?$ auto.php?id=$1 [L,QSA]

  # 3) /autos/ → autos.php · /admin/vehiculos/ → admin/vehiculos.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^(.+?)/?$ $1.php [L,QSA]
</IfModule>

<FilesMatch "\.(sql|md|log|sh)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
